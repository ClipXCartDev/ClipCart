# ClipCart — reverse proxy + static hosting, with automatic HTTPS.
#
# Cloudflare sits in front of this (proxied / orange cloud) so the origin IP is
# never public. That means every request arrives from a Cloudflare edge address,
# so the real client IP has to be read out of CF-Connecting-IP — otherwise every
# log line and every rate limit sees a Cloudflare address instead of the user.
(app) {
	encode gzip

	# API + health -> FastAPI (path preserved; app is mounted at /api/v1)
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else -> static files. Domain root shows the customer web app
	# (the product) — NOT the internal design deck.
	#
	# /srv is the whole deploy directory, which is this repository checked out:
	# .env, .git, the backend source and the ops scripts all live there. A bare
	# file_server hands every one of them to anybody who asks, so only the
	# paths that are meant to be public are served and the rest is 404.
	handle {
		@public path / /web/* /admin/* /downloads/* /app-config.json /favicon.ico
		handle @public {
			root * /srv
			@root path /
			rewrite @root /web/index.html
			file_server
		}
		handle {
			respond "Not found" 404
		}
	}
}

{
	# Ranges from https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched
	# 2026-10-16). Cloudflare changes these rarely; re-check if client IPs
	# ever start showing up as Cloudflare addresses.
	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Primary domain (auto Let's Encrypt HTTPS)
clipscart.app {
	import app
}

# www -> apex (canonical)
www.clipscart.app {
	redir https://clipscart.app{uri} permanent
}

# Plain HTTP for any other host — lets us smoke-test by raw IP before the DNS
# cutover, and keeps the health check reachable from inside the box.
http:// {
	import app
}
