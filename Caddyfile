# ClipCart — reverse proxy + static hosting, with automatic HTTPS.
# 38.9.96.250.nip.io resolves to the server IP, so Caddy can get a free Let's Encrypt
# cert (no domain purchase needed). The raw IP is still served over plain HTTP.
(app) {
	encode gzip

	# API + health -> FastAPI (path preserved; app is mounted at /api/v1)
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else -> static files. Domain root shows the customer web app
	# (the product) — NOT the internal design deck.
	handle {
		root * /srv
		@root path /
		rewrite @root /web/index.html
		file_server
	}
}

# HTTPS (auto Let's Encrypt) via the nip.io hostname
38.9.96.250.nip.io {
	import app
}

# Plain HTTP by raw IP (fallback / existing clients)
http://38.9.96.250 {
	import app
}
