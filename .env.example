# Copy to .env and fill in. Never commit .env (decisions §6.5).
ENV=dev

# Database
POSTGRES_USER=clipcart
POSTGRES_PASSWORD=clipcart
POSTGRES_DB=clipcart
# API container uses DATABASE_URL from compose; local runs default to sqlite.
# DATABASE_URL=postgresql+psycopg://clipcart:clipcart@localhost:5432/clipcart

# Auth
JWT_SECRET=please-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_DEVICES=2

# Google Sign-In
GOOGLE_CLIENT_ID=
